# Template for legal-ai/.env — copy to `.env` and fill in real values.
# `.env` is gitignored; this `.env.example` is safe to commit.
#
#   cp .env.example .env   # then edit
#
# vertex_config.py resolves these into config_vertex.yaml ${...} placeholders.

# --- Qdrant Cloud ---
QDRANT_URL=https://<your-cluster>.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>

# --- GCP / Vertex AI ---
# Option A (recommended): Application Default Credentials.
#   Run: gcloud auth application-default login
#   Then set your project id below; leave GOOGLE_API_KEY empty.
GCP_PROJECT=<your-gcp-project-id>
# Option B: API-key auth. Leave GCP_PROJECT empty and set this instead.
GOOGLE_API_KEY=

# --- Vertex AI Model Garden (backend: garden) ---
# Uses the same GCP_PROJECT as Vertex AI above (no separate variable needed).
# Qwen3-Embedding-8B Online Endpoint id (numeric).
GARDEN_EMBED_ENDPOINT_ID=
# Gemma 3 12B-it Online Endpoint id (numeric).
GARDEN_LLM_ENDPOINT_ID=
# Garden auth = Application Default Credentials (same as Vertex AI):
#   gcloud auth application-default login
