# Template for legal-ai/.env — copy to `.env` and fill in real values.
# `.env` is gitignored; this `.env.example` is safe to commit.
#
#   cp .env.example .env   # then edit
#
# vertex_config.py resolves these into config_vertex.yaml ${...} placeholders.

# --- Qdrant Cloud ---
QDRANT_URL=https://<your-cluster>.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>

# --- GCP / Vertex AI ---
# Option A (recommended): Application Default Credentials.
#   Run: gcloud auth application-default login
#   Then set your project id below; leave GOOGLE_API_KEY empty.
GCP_PROJECT=<your-gcp-project-id>
# Option B: API-key auth. Leave GCP_PROJECT empty and set this instead.
GOOGLE_API_KEY=

# --- self-deployed GPU endpoints (backend: gpu) ---
# Uses the same GCP_PROJECT as Vertex AI above (no separate variable needed).
# Qwen3-Embedding-8B Online Endpoint id (numeric).
GPU_EMBED_ENDPOINT_ID=
# LLM Online Endpoint id (Gemma 3 12B-it, Llama 3.1 8B, etc.).
GPU_LLM_ENDPOINT_ID=
# Dedicated domains IF the endpoint is a dedicated endpoint. Get them from:
#   gcloud ai endpoints list --region=<r> --format="value(dedicatedEndpointDns)"
# Leave empty for standard (shared-domain) OpenAI endpoints.
GPU_LLM_DNS=
GPU_EMBED_DNS=
# Gpu auth = Application Default Credentials (same as Vertex AI):
#   gcloud auth application-default login
